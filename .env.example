# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only, never expose to the browser. Used for privileged operations (e.g. invite validation).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma. Use the Supabase Postgres connection string (Project Settings > Database).
# Prefer the pooled connection string (port 6543) for the app, direct (5432) for migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# Scoring service (Part B). Configurable LLM provider behind one scoring service.
GEMINI_API_KEY="your-gemini-api-key"

# Transactional email (submission-scored, stage-milestone notifications).
# Without this set, notifications are skipped (logged, not sent) — nothing
# else in the app depends on it. Get a key at https://resend.com.
RESEND_API_KEY="your-resend-api-key"
# Must be a domain verified in your Resend account once you're past their
# sandbox/testing domain.
RESEND_FROM_EMAIL="Founda21 <notifications@yourdomain.com>"

# App-level secret mixed into founder ID/passport numbers before hashing
# (§ identity anchor). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_HASH_PEPPER="generate-a-random-64-char-hex-string"

# Comma-separated list of emails allowed into the platform-owner ops view at
# /admin (cross-institution visibility — § ops-tooling gap). Not a DB role;
# a fixed allowlist for internal operators only.
PLATFORM_ADMIN_EMAILS="you@yourcompany.com"

# Error monitoring (Sentry). Without SENTRY_DSN/NEXT_PUBLIC_SENTRY_DSN set,
# Sentry is entirely inert — no build-time plugin, no error reporting, zero
# effect on the app. Get a free DSN at https://sentry.io. Both DSN vars are
# normally the same value; NEXT_PUBLIC_ one is exposed to the browser for
# client-side errors, the other is server-only.
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# Optional: only needed for source-map upload at build time (readable stack
# traces in Sentry). Find these in Sentry project settings.
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
